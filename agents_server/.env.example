# Environment variables for ClinicalAgent server

# LLM Configuration
GROQ_API_KEY=your_groq_api_key_here

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/

# Neo4j Configuration (for knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ChromaDB Configuration
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Authentication
JWT_SECRET_KEY=your_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ML Model Configuration (Optional)
# Set to 1 to enable BioBERT enrollment prediction model
# WARNING: May cause crashes on some systems due to PyTorch/Transformers
# Default: disabled (0)
ENABLE_ML_PREDICTOR=0

# HuggingFace Offline Mode (for ML model)
# Set to 1 to use local models only, avoiding network calls
TRANSFORMERS_OFFLINE=1
HF_HUB_OFFLINE=1
TOKENIZERS_PARALLELISM=false